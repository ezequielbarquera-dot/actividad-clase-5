SubProceso resultado <- RepetirPalabraIterativa(palabra, veces)
    Definir resultado Como Cadena
    resultado <- ""
    Mientras veces > 0 Hacer
        Si resultado = "" Entonces
            resultado <- palabra
        Sino
            resultado <- resultado + " " + palabra
        FinSi
        veces <- veces - 1
    FinMientras
FinSubProceso
